# Copy to .env (never commit real values)
QASSA_ENV=production
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
POSTGRES_HOST=
POSTGRES_DB=qassa
POSTGRES_USER=qassa
POSTGRES_PASSWORD=
REDIS_URL=redis://redis:6379/1
QASSA_TENANT_BASE_DOMAIN=salons.example.com   # company PWA subdomains: <slug>.<this>
PLATFORM_HOST=app.example.com               # back-office host served by the web container
