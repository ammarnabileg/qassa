# ${PLATFORM_HOST}: platform back-office (React). Any other host: a company's customer PWA (Flutter);
# the backend decides which company owns the host (platform.TenantDomain) and rejects unknown hosts.
# compress the Flutter bundle (~3 MB of JS) and API responses
gzip on;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_types application/javascript text/css application/json application/manifest+json image/svg+xml font/ttf application/octet-stream application/wasm;

map $http_x_forwarded_proto $fwd_proto { default $http_x_forwarded_proto; "" $scheme; }

server {
  listen 80;
  server_name ${PLATFORM_HOST};
  root /usr/share/nginx/html/admin;
  client_max_body_size 10m;
  location ~ ^/(api|admin|static)/ { include /etc/nginx/conf.d/proxy.inc; }
  # hashed/static bundle files can be cached; index.html and the service worker must stay fresh
  location ~* \.(js|ttf|png|json|wasm)$ { add_header Cache-Control "public, max-age=3600"; try_files $uri =404; }
  location / { add_header Cache-Control "no-cache"; try_files $uri /index.html; }
}

server {
  listen 80 default_server;
  root /usr/share/nginx/html/pwa;
  location /api/ { include /etc/nginx/conf.d/proxy.inc; }
  # install name/colour per company
  location = /manifest.json { rewrite ^ /api/v1/public/manifest break; include /etc/nginx/conf.d/proxy.inc; }
  # hashed/static bundle files can be cached; index.html and the service worker must stay fresh
  location ~* \.(js|ttf|png|json|wasm)$ { add_header Cache-Control "public, max-age=3600"; try_files $uri =404; }
  location / { add_header Cache-Control "no-cache"; try_files $uri /index.html; }
}
